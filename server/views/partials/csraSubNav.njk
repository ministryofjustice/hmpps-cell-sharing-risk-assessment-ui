{#
  CSRA tab navigation. Reads `prisonerNumber` and `currentTab` ("current" | "history") from context,
  and `referrers` from res.locals (set by middleware/csraBreadcrumbs) so switching tabs keeps the
  pages the prisoner was reached through in the breadcrumb trail.
#}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}

{{ mojSubNavigation({
  label: "CSRA sections",
  items: [
    {
      text: "Current rating",
      href: appendReferrers("/prisoner/" + prisonerNumber, referrers),
      active: currentTab == "current"
    },
    {
      text: "CSRA history",
      href: appendReferrers("/prisoner/" + prisonerNumber + "/history", referrers),
      active: currentTab == "history"
    }
  ]
}) }}
