{% extends "../partials/layout.njk" %}

{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}

{% from "../macros/mojFilter.njk" import mojFilter %}
{% from "../macros/riskBadge.njk" import riskBadge %}

{% set prisonerName = (prisoner.firstName + " " + prisoner.lastName) | convertToTitleCase %}
{% set pageTitle = applicationName + " - CSRA history for " + prisonerName %}
{% set mainClasses = "govuk-body" %}
{% set currentTab = "history" %}

{% macro paginationSection(pagination, top) %}
  <div class="csra-pagination{% if top %} csra-pagination--top{% endif %}" data-qa="pagination">
    {{ govukPagination(pagination) }}

    <p class="csra-pagination__results">
      Showing <strong>{{ pagination.results.from }}</strong> to <strong>{{ pagination.results.to }}</strong>
      of <strong>{{ pagination.results.count }} CSRAs</strong>
    </p>
  </div>
{% endmacro %}

{% macro summaryCard(label, value, hint, qa) %}
  <div class="csra-summary__card">
    <p class="csra-summary__caption">{{ label }}</p>
    <p class="csra-summary__value" data-qa="{{ qa }}">{{ value }}</p>
    {% if hint %}
      <p class="csra-summary__hint">{{ hint }}</p>
    {% endif %}
  </div>
{% endmacro %}

{% macro csraHistoryEntry(review) %}
  {% set isLegacy = review.legacy %}
  {% set isAssessment = review.assessmentType == "ASSESSMENT" %}
  {% set isInterim = review.ratingStage == "INTERIM" %}
  {% set isProvisionalAssessment = isAssessment and not review.finalRating and review.provisionalRating %}
  {% set establishment = review.prisonName or establishmentNames[review.prisonId] or review.prisonId %}
  {% set reviewType = 'Review' %}

  {% if isAssessment %}
    {% if isProvisionalAssessment %}
      {% set reviewType = 'Provisional assessment' %}
    {% else %}
      {% set reviewType = 'Assessment' %}
    {% endif %}
  {% endif %}

  <div class="csra-review csra-history-entry" data-qa="csra-history-entry">
    <div class="csra-review__header">
      <div class="csra-review__header__left">
        {% if not isLegacy %}
          <span class="csra-review__type govuk-caption-m govuk-!-margin-bottom-3">
            {{ reviewType }}
          </span>
        {% endif %}

        {% set badgeStage = "" %}
        {% if isProvisionalAssessment %}
          {% set badgeStage = "PROVISIONAL" %}
          {% elif isInterim %}
          {% set badgeStage = "INTERIM" %}
        {% endif %}

        <div class="csra-review__badge-container">
          {{ riskBadge({ rating: review.legacy.level or review.finalRating or review.provisionalRating, ratingStage: badgeStage }) }}

          {% if isLegacy %}
            {% if review.legacy.approvalStatus == "NOT_APPROVED" %}
              {{ govukTag({ text: "Not approved", classes: "govuk-tag--orange", attributes: { "data-qa": "approval-state" } }) }}
              {% elif review.legacy.level and review.legacy.calculatedLevel and review.legacy.level != review.legacy.calculatedLevel %}
              {{ govukTag({ text: "Level changed at approval", classes: "govuk-tag--blue", attributes: { "data-qa": "approval-state" } }) }}
              {% elif review.legacy.approvalStatus == "APPROVED" %}
              {{ govukTag({ text: "Approved", classes: "govuk-tag--green", attributes: { "data-qa": "approval-state" } }) }}
            {% endif %}
          {% endif %}
        </div>
      </div>

      {% if not isInterim %}
        <a class="govuk-link" href="/prisoner/{{ prisonerNumber }}/history/{{ review.id }}{{ fromQuery }}" data-qa="view-full-link">
          View

          {% if isLegacy %}
            details
          {% else %}
            full {{ reviewType | lower }}
          {% endif %}
        </a>
      {% endif %}
    </div>

    {% if isLegacy %}
      {% set finalRatingLabel = 'Approval comment' %}
      {% set finalRatingComment = review.legacy.approvalComment or review.legacy.approvalCommitteeComment %}
      {% set finalRatingDate = review.legacy.approvalDate %}
      {% set provisionalRatingLabel = 'Assessment comment' %}
      {% set provisionalRatingComment = review.legacy.assessmentComment %}
      {% set provisionalRatingDate = review.legacy.assessmentDate %}
    {% else %}
      {% set approvalTagStatus = review.approvalStatus %}

      {% set finalRatingComment = review.finalReviewComment %}
      {% set finalRatingCommentType = 'Assessed' %}
      {% set finalRatingDate = review.finalRecordedDate %}
      {% set provisionalRatingCommentType = 'Assessed' %}
      {% set provisionalRatingComment = review.provisionalReviewComment %}
      {% set provisionalRatingDate = review.provisionalRecordedDate %}

      {% if review.type === 'CSRA_REVIEW' %}
        {% set finalRatingLabel = 'Review comment' %}
        {% set provisionalRatingLabel = 'Provisional review comment' %}
      {% else %}
        {% set finalRatingLabel = 'Assessment comment' %}
        {% set provisionalRatingLabel = 'Provisional assessment comment' %}
      {% endif %}
    {% endif %}

    {% if review.closureReason %}
      <p class="govuk-body csra-review__comment">
        <strong>
          {% if review.type === 'CSRA_REVIEW' %}
            Review
          {% else %}
            Full assessment
          {% endif %}
          not completed due to prisoner
          {{ 'transfer' if review.closureReason === 'NOT_COMPLETED_PRISONER_TRANSFER' else 'release' }}.
        </strong>
      </p>
    {% endif %}

    {% if review.riskTo.length %}
      <p class="govuk-body govuk-!-margin-bottom-0"><strong>Risk to:</strong></p>
      <ul class="govuk-list govuk-list--bullet" data-qa="csra-risk-to">
        {% for risk in review.riskTo %}
          <li>{{ risk.category | enumLabel }}{% if risk.details %} — {{ risk.details }}{% endif %}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if review.vulnerabilities.length %}
      <h2 class="govuk-body govuk-!-margin-bottom-0"><strong>Vulnerable due to:</strong></h2>
      <ul class="govuk-list govuk-list--bullet" data-qa="csra-vulnerabilities">
        {% for vulnerability in review.vulnerabilities %}
          <li>{{ vulnerability.category | enumLabel }}{% if vulnerability.details %} — {{ vulnerability.details }}{% endif %}</li>
        {% endfor %}
      </ul>
    {% endif %}


    {% if finalRatingDate %}
      <p class="govuk-body csra-review__comment">
        <strong>{{ finalRatingLabel }}:</strong><br>
        {{ finalRatingComment or "No " + finalRatingLabel | lower + " entered." }}
      </p>
      <p class="govuk-body-m csra-review__meta">
        {{ finalRatingCommentType }} at {{ establishment or review.prisonId or "an unknown establishment" }}
        <br>
        {{ finalRatingDate | formatDate }}
      </p>
    {% endif %}

    {% if provisionalRatingDate %}
      <p class="govuk-body csra-review__comment">
        <strong>{{ provisionalRatingLabel }}:</strong><br>
        {{ provisionalRatingComment or "No " + provisionalRatingLabel | lower + " entered." }}
      </p>
      <p class="govuk-body-m csra-review__meta">
        {{ provisionalRatingCommentType }} at {{ establishment or review.prisonId or "an unknown establishment" }}
        <br>
        {{ provisionalRatingDate | formatDate }}
      </p>
    {% endif %}
  </div>
{% endmacro %}

{% set optionsHtml %}
  {{ govukCheckboxes({
    idPrefix: "ratings",
    name: "ratings",
    classes: "govuk-checkboxes--small",
    fieldset: { legend: { text: "CSRA rating type", classes: "govuk-fieldset__legend--s" } },
    items: ratingOptions
  }) }}

  {% if establishmentOptions.length %}
    {{ govukCheckboxes({
      idPrefix: "establishments",
      name: "establishments",
      classes: "govuk-checkboxes--small",
      fieldset: { legend: { text: "Establishment", classes: "govuk-fieldset__legend--s" } },
      items: establishmentOptions
    }) }}
  {% endif %}

  {% call govukFieldset({
    legend: { text: "Date from (earliest)", classes: "govuk-fieldset__legend--s" }
  }) %}
    {{ mojDatePicker({
      id: "fromDate",
      name: "fromDate",
      value: filters.fromDate,
      errorMessage: validationErrors.fromDate if validationErrors,
      label: {
        text: "Date from (earliest)",
        classes: "govuk-visually-hidden"
      },
      hint: { text: "For example, 1/2/2026" }
    }) }}
  {% endcall %}

  {% call govukFieldset({
    legend: { text: "Date to (latest)", classes: "govuk-fieldset__legend--s" }
  }) %}
    {{ mojDatePicker({
      id: "toDate",
      name: "toDate",
      value: filters.toDate,
      errorMessage: validationErrors.toDate if validationErrors,
      label: {
        text: "Date to (latest)",
        classes: "govuk-visually-hidden"
      },
      hint: { text: "For example, 1/2/2027" }
    }) }}
  {% endcall %}
{% endset %}

{% block content %}
  {% include "../partials/prisonerBanner.njk" %}
  {% include "../partials/csraSubNav.njk" %}

  <h1 class="govuk-heading-xl govuk-!-margin-bottom-6" data-qa="page-heading">CSRA history</h1>

  {% if hasHistory %}
    <div class="csra-summary" data-qa="csra-summary">
      {{ summaryCard("Total CSRAs", history.summary.totalCsras, summaryRange, "summary-total") }}
      {% set highHint = "" %}
      {% if history.summary.lastHighDate %}
        {% set highHint = "Last high " + (history.summary.lastHighDate | formatDate) %}
      {% endif %}
      {{ summaryCard("High ratings", history.summary.highCount, highHint, "summary-high") }}
      {{ summaryCard("Standard ratings", history.summary.standardCount, "", "summary-standard") }}
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter">
        <form method="get" action="/prisoner/{{ prisonerNumber }}/history" novalidate data-qa="csra-filters">
          {% if fromQuery %}
            <input type="hidden" name="from" value="{{ fromKey }}">
          {% endif %}
          {{ mojFilter({
            attributes: { "data-qa": "csra-filter-panel" },
            selectedFilters: { heading: { text: "Filter" } },
            optionsHtml: optionsHtml,
            submit: { attributes: { "data-qa": "apply-filters" } },
            clearFiltersUrl: "/prisoner/" + prisonerNumber + "/history" + (fromQuery or "")
          }) }}
        </form>
      </div>

      <div class="govuk-grid-column-three-quarters">
        {% if hasResults %}
          {% if pagination %}
            {{ paginationSection(pagination, true) }}
          {% endif %}

          {% for review in history.content %}
            {{ csraHistoryEntry(review) }}
          {% endfor %}

          {% if pagination %}
            {{ paginationSection(pagination, false) }}
          {% endif %}
        {% else %}
          <p class="govuk-body" data-qa="no-results">No history has been found for the selected filters.</p>
          <p class="govuk-body">You can:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li>select different CSRA rating types</li>
            <li>select different establishments</li>
            <li>choose different dates</li>
            <li>clear filters to view all history for the prisoner</li>
          </ul>
        {% endif %}
      </div>
    </div>
  {% else %}
    <p class="govuk-body" data-qa="no-history">There are no CSRA assessments or reviews for this prisoner.</p>
  {% endif %}
{% endblock %}
