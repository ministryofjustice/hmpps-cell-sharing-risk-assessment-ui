{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "../macros/csraAnswersSummary.njk" import csraAnswersSummary %}

{% set prisonerName = (prisoner.firstName + " " + prisoner.lastName) | convertToTitleCase %}
{% set title = "Check answers before you confirm a CSRA rating" %}
{% set pageTitle = applicationName + " - " + title %}

{% block outerHeading %}
  {% include "../partials/compactPrisonerBanner.njk" %}

  {{ super() }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if assessment.interimResult %}
        <div class="csra-check-answers-section">
          <h2 class="govuk-heading-m">Provisional assessment</h2>

          {{ govukSummaryList({
            rows: [
              {
                key: {
                  text: "Have you reviewed the provisional assessment?"
                },
                value: {
                  text: (assessmentAnswers.provisionalReviewed | yesNoValue) or "Not answered"
                },
                actions: {
                  items: [
                    {
                      href: appendReferrers("/prisoner/" + prisoner.prisonerNumber + "/csra/" + assessment.assessmentId + "/review-provisional", referrers),
                      text: "Change",
                      visuallyHiddenText: "Have you reviewed the provisional assessment?"
                    }
                  ]
                }
              }
            ]
          }) }}
        </div>
      {% endif %}

      {{ csraAnswersSummary({
        prisoner: prisoner,
        assessment: assessment,
        assessmentAnswers: assessmentAnswers,
        provisionalAnswers: provisionalAnswers,
        offenceEvidenceMap: offenceEvidenceMap,
        flowConfig: flowConfig,
        referrers: referrers
      }) }}

      {% include "../partials/csraRemainingTasks.njk" %}

      {% if remainingTasks.length %}
        {% call govukInsetText() %}
          <p>
            As the assessment is incomplete, you can only enter a provisional CSRA rating. It will stay provisional until the assessment is completed and a final rating is entered.
          </p>
        {% endcall %}
      {% endif %}

      <div class="govuk-body">
        <a class="govuk-button" href="{{ appendReferrers('/prisoner/' + prisoner.prisonerNumber + '/csra/' + assessment.assessmentId + '/select-rating', referrers) }}" data-qa="continue-button">
          {% if submitType == 'PROVISIONAL' %}
            Continue to provisional rating
          {% else %}
            Continue to rating
          {% endif %}
        </a>

        <p>
          <a href="{{ cancelLink }}" class="govuk-link">Cancel</a>
        </p>
      </div>
    </div>
  </div>
{% endblock %}
