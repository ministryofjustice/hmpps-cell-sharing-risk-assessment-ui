{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../macros/csraAnswersSummary.njk" import csraAnswersSummary %}

{% set prisonerName = (prisoner.firstName + " " + prisoner.lastName) | convertToTitleCase %}
{% set title = "Check answers before you confirm a CSRA rating" %}
{% set pageTitle = applicationName + " - " + title %}

{% block outerHeading %}
  {% include "../partials/compactPrisonerBanner.njk" %}

  {{ super() }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ csraAnswersSummary({
        prisoner: prisoner,
        assessment: assessment,
        assessmentAnswers: assessmentAnswers,
        flowConfig: flowConfig
      }) }}

      <form method="post" action>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

        {{ govukButton({
          text: "WIP: Save provisional rating",
          classes: "govuk-!-margin-bottom-0",
          attributes: { "data-qa": "prison-search-button" }
        }) }}
      </form>

      <a href="#" class="govuk-link">Cancel</a>
    </div>
  </div>
{% endblock %}
