{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% from "../macros/csraSummary.njk" import csraSummary %}
{% from "../macros/legacyCsraSummary.njk" import legacyCsraSummary %}

{% set prisonerName = (prisoner.firstName + " " + prisoner.lastName) | convertToTitleCase %}
{% set title = "Cell sharing risk assessment - " + prisonerName %}
{% if provisionalAssessmentAnswers and not finalAssessmentAnswers %}
  {% set title = title.replace('Cell', 'Provisional cell') %}
{% endif %}
{% set pageTitle = applicationName + " - " + title %}

{% set finalSummaryHtml %}
  {{ csraSummary({
    prisoner: prisoner,
    cellSharingHistory: cellSharingHistory,
    assessmentAnswers: finalAssessmentAnswers,
    offenceEvidenceMap: finalOffenceEvidenceMap,
    flowConfig: flowConfig,
    detailedRating: detailedRating,
    userDisplayNames: userDisplayNames,
    csraRiskToCategoryLabelMap: csraRiskToCategoryLabelMap,
    csraVulnerabilityCategoryLabelMap: csraVulnerabilityCategoryLabelMap,
    summaryRows: finalSummaryRows
  }) }}
{% endset %}

{% set provisionalSummaryHtml %}
  {{ csraSummary({
    prisoner: prisoner,
    cellSharingHistory: cellSharingHistory,
    assessmentAnswers: provisionalAssessmentAnswers,
    offenceEvidenceMap: provisionalOffenceEvidenceMap,
    flowConfig: flowConfig,
    detailedRating: detailedRating,
    userDisplayNames: userDisplayNames,
    csraRiskToCategoryLabelMap: csraRiskToCategoryLabelMap,
    csraVulnerabilityCategoryLabelMap: csraVulnerabilityCategoryLabelMap,
    summaryRows: provisionalSummaryRows
  }) }}
{% endset %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if finalAssessmentAnswers and provisionalAssessmentAnswers %}
        {% set finalHtml %}
          <h2 class="govuk-heading-l">Final assessment</h2>

          {{ finalSummaryHtml | safe }}
        {% endset -%}

        {% set provisionalHtml %}
          <h2 class="govuk-heading-l">Provisional assessment</h2>

          {{ provisionalSummaryHtml | safe }}
        {% endset -%}

        {{ govukTabs({
          items: [
            {
              label: "Final assessment",
              id: 'final-assessment',
              panel: {
                html: finalHtml
              }
            },
            {
              label: "Provisional assessment",
              id: 'provisional-assessment',
              panel: {
                html: provisionalHtml
              }
            }
          ],
          classes: 'govuk-tabs--borderless'
        }) }}
      {% elseif finalAssessmentAnswers %}
        {{ finalSummaryHtml | safe }}
      {% elseif provisionalAssessmentAnswers %}
        {{ provisionalSummaryHtml | safe }}
      {% else %}
        {% if detailedRating.legacy.approvalStatus == "APPROVED" %}
          {{ govukTag({ text: "Approved", classes: "govuk-tag--green govuk-!-margin-bottom-5", attributes: { "data-qa": "approval-state" } }) }}
        {% endif %}

        {% set ratingDate = detailedRating.startedAt | formatDate %}
        {% if ratingDate %}
          <p>
            Assessed
            {{- " on " + ratingDate if ratingDate }}
          </p>
        {% endif %}

        {{ govukSummaryList({
          rows: legacySummaryRows
        }) }}

        <h3 class="govuk-heading-m">Review questions</h3>

        {{ govukSummaryList({
          rows: legacyQuestionsRows
        }) }}
      {% endif %}

      {{ govukButton({
        text: backLinkText.replace('Back', 'Return'),
        href: backLink
      }) }}
    </div>
  </div>
{% endblock %}
