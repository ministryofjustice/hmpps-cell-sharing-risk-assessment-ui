{% extends "../partials/layout.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = applicationName + " - Reviews in progress" %}

{% set reviewButtonsHtml %}
  {% if canEditReviews %}
    <div class="csra-reviews-in-progress-table__actions">
      <a class="govuk-button govuk-button--secondary continue-review-button" href="#">Continue review</a>
      <a class="govuk-link cancel-review-link" href="#">Cancel review</a>
    </div>
  {% endif %}
{% endset %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-top-5">
    <div class="govuk-grid-column-full">
      <p class="govuk-body">Prisoners who have a cell sharing risk review in progress.</p>

      {% if reviewsInProgress.length > 0 %}
        {% set rows = [] %}
        {% for review in reviewsInProgress %}
          {% set name = review.lastName | capitalize ~ ', ' ~ review.firstName | capitalize %}
          {% set imageHtml %}
            <img src="/prisoner/{{ review.prisonerNumber }}/image" alt="Image of {{ name }}" class="csra-prisoner-image" />
          {% endset %}
          {% set nameHtml %}
            <a class="govuk-link" href="/prisoner/{{ review.prisonerNumber }}">{{ name }}</a>
            <br>
            <span class="csra-recent-arrivals__prisoner-number">{{ review.prisonerNumber }}</span>
          {% endset %}
          {% set startedByHtml %}
            {{ review.startedBy | userDisplayName }} on {{ review.startedOn | formatDayMonthYear }}
          {% endset %}
          {% set row = [
            { html: imageHtml },
            { html: nameHtml },
            { html: startedByHtml },
            { html: reviewButtonsHtml }
          ] %}
          {% set _ = rows.push(row) %}
        {% endfor %}

        {{ govukTable({
          head: [
            { text: "" , classes: "prisoner-image-column-header" },
            { text: "Name" },
            { text: "Review started by" },
            { text: "" }
          ],
          classes: "csra-table csra-reviews-in-progress-table",
          rows: rows
        }) }}
      {% else %}
        <p class="govuk-body">There are no prisoners with a review in progress.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
