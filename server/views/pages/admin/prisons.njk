{% extends "../../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set pageTitle = applicationName + " - Manage enabled prisons" %}
{% set mainClasses = "govuk-body" %}

{% block content %}
  {% if successMessage %}
    {{ govukNotificationBanner({
      type: "success",
      text: successMessage,
      attributes: { "data-qa": "success-banner" }
    }) }}
  {% endif %}

  {% if errorMessage %}
    {{ govukNotificationBanner({
      titleText: "There is a problem",
      text: errorMessage,
      attributes: { "data-qa": "error-banner" }
    }) }}
  {% endif %}

  <p class="govuk-body-l govuk-!-margin-top-4 govuk-!-margin-bottom-6" data-qa="active-count">
    CSRA is switched on for {{ activeCount }} of {{ totalCount }} prisons.
  </p>

  {% if not nomisScreenAvailable %}
    <p class="govuk-inset-text" data-qa="nomis-unavailable">
      The NOMIS CSRA screen ({{ nomisModules }}) status is currently unavailable. One or more may not
      have been set up in NOMIS yet. Prisons cannot be turned on or off until it is.
    </p>
  {% elif not nomisSwitchesAvailable %}
    <p class="govuk-inset-text" data-qa="nomis-switches-unavailable">
      The NOMIS CSRA switches ({{ nomisSwitches }}) are currently unavailable. They may not have been set
      up in this NOMIS environment yet. Turning a prison on still blocks its NOMIS CSRA screens, but the
      NOMIS header will not change and the approval step cannot be removed.
    </p>
  {% elif approvalRemovedNationally %}
    <p class="govuk-inset-text" data-qa="nomis-approval-national">
      The NOMIS approval step has been removed for every prison in NOMIS, so it cannot be changed here
      prison by prison.
    </p>
  {% endif %}

  <form method="get" action="/admin/prisons" class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group govuk-!-margin-bottom-0">
      <label class="govuk-label govuk-label--s govuk-!-margin-bottom-1" for="q">Search by prison name or ID</label>
      <div class="csra-admin-search">
        <input class="govuk-input govuk-input--width-20 govuk-!-margin-bottom-0" id="q" name="q" type="text"
               value="{{ search }}" data-qa="prison-search"/>
        {{ govukButton({
          text: "Search",
          classes: "govuk-!-margin-bottom-0",
          attributes: { "data-qa": "prison-search-button" }
        }) }}
      </div>
    </div>
  </form>

  {% if agencies.length %}
    {% set showApproval = nomisScreenAvailable and nomisSwitchesAvailable %}
    {% set rows = [] %}
    {% for agency in agencies %}
      {% set prison %}
        {{ agency.name }}
        <span class="govuk-body-s govuk-hint govuk-!-display-block govuk-!-margin-bottom-0">{{ agency.agencyId }}</span>
      {% endset %}

      {% set statusTag %}
        {% if agency.active %}
          {{ govukTag({ text: "On", classes: "govuk-tag--green" }) }}
        {% else %}
          {{ govukTag({ text: "Off", classes: "govuk-tag--grey" }) }}
        {% endif %}
        {% if nomisScreenAvailable and not agency.nomis.matchesDps %}
          {# NOMIS is not where turning the prison on or off would have put it: changed elsewhere, or a
             change part-applied. Turning it on or off again puts it right. #}
          <div class="csra-admin-attention">
            {{ govukTag({
              text: "NOMIS needs attention",
              classes: "govuk-tag--orange",
              attributes: { "data-qa": "nomis-attention-" + agency.agencyId }
            }) }}
          </div>
        {% endif %}
      {% endset %}

      {% set toggle %}
        {# A prison needing attention is offered both, so the admin can re-apply the state they want. #}
        {% set turnOnTargets = [not agency.active] if (agency.nomis.matchesDps or not nomisScreenAvailable) else [true, false] %}
        {% for turnOn in turnOnTargets %}
          <form method="post" action="/admin/prisons/{{ agency.agencyId }}" novalidate class="csra-admin-inline-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
            <input type="hidden" name="active" value="{{ 'true' if turnOn else 'false' }}"/>
            <input type="hidden" name="name" value="{{ agency.name }}"/>
            <input type="hidden" name="q" value="{{ search }}"/>
            {{ govukButton({
              text: ("Turn on" if turnOn else "Turn off"),
              classes: "govuk-button--secondary govuk-!-margin-bottom-0",
              attributes: { "data-qa": ("turn-on-" if turnOn else "turn-off-") + agency.agencyId }
            }) }}
          </form>
        {% endfor %}
      {% endset %}

      {% set approvalTag %}
        {% if not showApproval %}
          {{ govukTag({ text: "Unknown", classes: "govuk-tag--grey" }) }}
        {% elif agency.active %}
          {# Every NOMIS CSRA screen is blocked, so the step does not apply. #}
          <span class="govuk-hint govuk-!-margin-bottom-0">Not used</span>
        {% elif agency.nomis.approval == "NOT_REQUIRED" %}
          {{ govukTag({ text: "Not required", classes: "govuk-tag--blue" }) }}
        {% else %}
          {{ govukTag({ text: "Required", classes: "govuk-tag--grey" }) }}
        {% endif %}
      {% endset %}

      {% set approvalAction %}
        {% if showApproval and not approvalRemovedNationally and not agency.active %}
          {% set notRequired = agency.nomis.approval == "NOT_REQUIRED" %}
          <form method="post" action="/admin/prisons/{{ agency.agencyId }}/nomis-approval" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
            <input type="hidden" name="approval" value="{{ 'REQUIRED' if notRequired else 'NOT_REQUIRED' }}"/>
            <input type="hidden" name="name" value="{{ agency.name }}"/>
            <input type="hidden" name="q" value="{{ search }}"/>
            {{ govukButton({
              text: ("Restore approval" if notRequired else "Remove approval"),
              classes: "govuk-button--secondary govuk-!-margin-bottom-0",
              attributes: { "data-qa": ("nomis-approval-restore-" if notRequired else "nomis-approval-remove-") + agency.agencyId }
            }) }}
          </form>
        {% endif %}
      {% endset %}

      {% set rows = (rows.push([
        { html: prison, attributes: { "data-qa": "name-" + agency.agencyId } },
        { html: statusTag, attributes: { "data-qa": "status-" + agency.agencyId } },
        { html: toggle, classes: "govuk-!-text-align-right csra-admin-action" },
        { html: approvalTag, attributes: { "data-qa": "nomis-approval-" + agency.agencyId } },
        { html: approvalAction, classes: "govuk-!-text-align-right csra-admin-action" }
      ]), rows) %}
    {% endfor %}

    {{ govukTable({
      attributes: { "data-qa": "prisons-table" },
      head: [
        { text: "Prison" },
        { text: "CSRA in DPS" },
        { text: "Action", classes: "govuk-!-text-align-right" },
        { text: "NOMIS approval step" },
        { text: "Action", classes: "govuk-!-text-align-right" }
      ],
      rows: rows
    }) }}
  {% else %}
    <p class="govuk-body" data-qa="no-results">No prisons match your search.</p>
  {% endif %}
{% endblock %}
