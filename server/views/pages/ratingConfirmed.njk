{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% set pageTitle = applicationName + " - Provisional CSRA rating confirmed" %}
{% set prisonerName = prisoner.firstName | convertToTitleCase %}
{% set isProvisional = csra.status === 'PROVISIONAL' %}

{% block heading %}
  {% include "../partials/compactPrisonerBanner.njk" %}

  {{ super() }}
{% endblock %}

{% block beforeContent %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% call govukPanel({
        titleText: ("Provisional " if isProvisional else "") + "CSRA rating confirmed",
        classes: 'govuk-!-margin-bottom-6'
      }) %}
        {{ prisonerName }} is rated {{ csra.rating | csraRatingLabel('PROVISIONAL' if isProvisional) }}
      {% endcall %}

      {% if isProvisional and csra.rating === 'HIGH_SPECIFIC' %}
        <h2 class="govuk-heading-m">
          What must happen next
        </h2>

        <p class="govuk-body">
          CSRA policy requires a manager to approve who the prisoner temporarily shares a cell with. Follow your local
          process for this.
        </p>

        <p class="govuk-body">
          {{ prisonerName }}’s CSRA record will include their cell location and who they were sharing with during
          the provisional assessment.
        </p>
      {% endif %}

      <p class="govuk-body">
        {{ govukButton({
          text: 'Finish',
          href: cancelLink,
          classes: "govuk-!-margin-top-3",
          attributes: { "data-qa": "finish-button" }
        }) }}
      </p>
    </div>
  </div>
{% endblock %}
