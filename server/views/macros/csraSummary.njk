{% macro csraSummary(params) %}
  {% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
  {% from "govuk/components/table/macro.njk" import govukTable %}

  {% from './csraAnswersSummary.njk' import csraAnswersSummary %}

  {% set prisoner = params.prisoner %}
  {% set cellSharingHistory = params.cellSharingHistory %}
  {% set assessment = params.assessment %}
  {% set assessmentAnswers = params.assessmentAnswers %}
  {% set offenceEvidenceMap = params.offenceEvidenceMap %}
  {% set flowConfig = params.flowConfig %}
  {% set detailedRating = params.detailedRating %}
  {% set userDisplayNames = params.userDisplayNames %}
  {% set csraRiskToCategoryLabelMap = params.csraRiskToCategoryLabelMap %}
  {% set csraVulnerabilityCategoryLabelMap = params.csraVulnerabilityCategoryLabelMap %}
  {% set summaryRows = params.summaryRows %}

  {% set isProvisional = assessmentAnswers.stage === 'PROVISIONAL' %}
  {% set rating = (assessment.interimResult if isProvisional else (assessment.finalResult or detailedRating.rating)) %}
  {% set ratingDate = (detailedRating.provisionalDate if isProvisional else detailedRating.finalDate) | formatDate %}
  {% set ratingTime = (detailedRating.provisionalTime if isProvisional else detailedRating.finalTime) | formatTime %}
  {% set completedBy = detailedRating.provisionalCompletedBy if isProvisional else detailedRating.finalCompletedBy %}
  {% set assessmentComment = detailedRating.provisionalAssessmentComment if isProvisional else detailedRating.assessmentComment %}

  <p>
    Assessed
    {{- " at " + detailedRating.prisonName if detailedRating.prisonName }}
    {{- " on " + ratingDate if ratingDate }}
    {{- " at " + ratingTime if ratingTime }}.
  </p>

  <div class="csra-check-answers-section">
    <h2 class="govuk-heading-m">Rating and comment</h2>

    {% set riskToHtml = "" %}
    {% if assessmentAnswers.riskTo.length %}
      {% for riskTo in assessmentAnswers.riskTo %}
        {% set riskToHtml = riskToHtml + "<p>" + csraRiskToCategoryLabelMap[riskTo.category] + (" - " + (riskTo.details | e) if riskTo.details else "") + "</p>" %}
      {% endfor %}
    {% endif %}

    {% set vulnerabilitiesHtml = "" %}
    {% if assessmentAnswers.vulnerabilities.length %}
      {% for vulnerability in assessmentAnswers.vulnerabilities %}
        {% set vulnerabilitiesHtml = vulnerabilitiesHtml + "<p>" + csraVulnerabilityCategoryLabelMap[vulnerability.category] + (" - " + (vulnerability.details | e) if vulnerability.details else "") + "</p>" %}
      {% endfor %}
    {% endif %}

    {{ govukSummaryList({
      rows: summaryRows
    }) }}
  </div>

  {% if assessmentAnswers %}
    {{ csraAnswersSummary({
      prisoner: prisoner,
      assessment: assessment,
      assessmentAnswers: assessmentAnswers,
      offenceEvidenceMap: offenceEvidenceMap,
      flowConfig: flowConfig,
      showChangeLinks: false
    }) }}
  {% endif %}

  {% if isProvisional and rating === 'HIGH_SPECIFIC' %}
    <div class="csra-check-answers-section">
      <h2 class="govuk-heading-m">Cell sharing history while high risk – specific (provisional)</h2>

      {% if cellSharingHistory %}
        {{ govukTable({
          attributes: { "data-qa": "cell-history-table" },
          firstCellIsHeader: true,
          head: [
            { text: "Location" },
            { text: "Shared with" },
            { text: "" }
          ],
          rows: cellSharingHistory
        }) }}
      {% else %}
        <p>No cell sharing recorded while provisionally high risk – specific.</p>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}
