{% from "moj/components/badge/macro.njk" import mojBadge %}

{% macro riskBadge(params) %}
  {% set badgeLabelHtml = {
    "HIGH": "<strong>HIGH RISK</strong>",
    "HIGH_GENERAL": "<strong>HIGH RISK</strong> GENERAL",
    "HIGH_SPECIFIC": "<strong>HIGH RISK</strong> SPECIFIC",
    "STANDARD": "<strong>STANDARD RISK</strong>"
  } %}

  {% set badgeClasses = {
    "HIGH": "risk-badge--very-high",
    "HIGH_GENERAL": "risk-badge--very-high",
    "HIGH_SPECIFIC": "risk-badge--high",
    "STANDARD": "risk-badge--low"
  } %}

  {# An assessment's Day 1 rating and a review's first-sitting rating are both unconfirmed, but users are
     told they are called different things, so the API distinguishes them with ratingStage. Fall back to
     the older provisional boolean for callers that have only that. #}
  {% set stageSuffix = {
    "PROVISIONAL": "(PROVISIONAL)",
    "INTERIM": "(INTERIM)"
  } %}

  {% set badgeLabel = badgeLabelHtml[params.rating] if params.rating else "<strong>NO RATING</strong>" %}
  {% set suffix = stageSuffix[params.ratingStage] if params.ratingStage else ("(PROVISIONAL)" if params.provisional else "") %}
  {% if suffix %}
    {% set badgeLabel = badgeLabel + "<br>" + suffix %}
  {% endif %}

  {{ mojBadge({
    html: badgeLabel | safe,
    classes: "risk-badge " ~ badgeClasses[params.rating]
  }) }}
{% endmacro %}
